{
  "name": "@qq296629801/dsh-headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsadasdasdsad035-spec/deepseek-harness-digital-employee.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./employee": {
      "types": "./lib/types/employee-runner.d.ts",
      "default": "./lib/employee-runner.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/employee-runner.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@qq296629801/dsh-cmdline": "workspace:^",
    "@qq296629801/dsh-code-runtime-worker-thread": "workspace:^",
    "@qq296629801/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@qq296629801/cordis": "workspace:^",
    "@qq296629801/cordis-plugin-loader": "workspace:^",
    "@qq296629801/dsh-agent": "workspace:^",
    "@qq296629801/dsh-agent-default-model": "workspace:^",
    "@qq296629801/dsh-digital-employee": "workspace:^",
    "@qq296629801/dsh-digital-employee-agent": "workspace:^",
    "@qq296629801/dsh-digital-employee-file": "workspace:^",
    "@qq296629801/dsh-goal": "workspace:^",
    "@qq296629801/dsh-home-paths": "workspace:^",
    "@qq296629801/dsh-invariants": "workspace:^",
    "@qq296629801/dsh-llm": "workspace:^",
    "@qq296629801/dsh-session": "workspace:^"
  },
  "devDependencies": {
    "@qq296629801/cordis": "workspace:^",
    "@qq296629801/cordis-plugin-loader": "workspace:^",
    "@qq296629801/dsh-agent": "workspace:^",
    "@qq296629801/dsh-agent-default-model": "workspace:^",
    "@qq296629801/dsh-digital-employee": "workspace:^",
    "@qq296629801/dsh-digital-employee-agent": "workspace:^",
    "@qq296629801/dsh-digital-employee-file": "workspace:^",
    "@qq296629801/dsh-goal": "workspace:^",
    "@qq296629801/dsh-home-paths": "workspace:^",
    "@qq296629801/dsh-invariants": "workspace:^",
    "@qq296629801/dsh-llm": "workspace:^",
    "@qq296629801/dsh-session": "workspace:^"
  }
}
