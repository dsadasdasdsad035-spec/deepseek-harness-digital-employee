{
  "format": 1,
  "kind": "mcp",
  "id": "mcp-market-template",
  "version": "1.0.0",
  "display": {
    "name": "MCP market template",
    "description": "Publisher template for Streamable HTTP and stdio MCP packages."
  },
  "publisher": {
    "id": "replace-with-publisher-id",
    "signature": "REPLACE_WITH_ED25519_SIGNATURE_BASE64"
  },
  "files": {
    "README.md": "GENERATED_SHA256"
  },
  "servers": [
    {
      "id": "example-service",
      "transport": "streamable-http",
      "url": "https://mcp.example.com",
      "headers": {
        "Authorization": ""
      },
      "credentialReferences": {
        "Authorization": "EXAMPLE_MCP_TOKEN"
      }
    },
    {
      "id": "example-local",
      "transport": "stdio",
      "command": "node",
      "args": ["server/index.js"],
      "env": {
        "LOG_LEVEL": "info",
        "API_TOKEN": ""
      },
      "credentialReferences": {
        "API_TOKEN": "EXAMPLE_MCP_TOKEN"
      }
    }
  ]
}
