    "@qq296629801/dsh-home-paths": "workspace:^",
    "@qq296629801/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@qq296629801/cordis": "workspace:^",
    "@qq296629801/dsh-atomic-write": "workspace:^",
    "@qq296629801/dsh-company": "workspace:^",
