  },
  "devDependencies": {
    "@qq296629801/cordis": "workspace:^",
    "@qq296629801/dsh-credentials": "workspace:^",
    "@qq296629801/dsh-invariants": "workspace:^",
    "@types/nodemailer": "^6.4.16"
  }
